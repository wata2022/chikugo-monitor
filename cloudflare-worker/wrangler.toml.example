name = "chikugo-monitor-update-trigger"
main = "update-trigger.js"
compatibility_date = "2026-07-04"

[vars]
ALLOWED_ORIGIN = "https://wata2022.github.io"
GITHUB_OWNER = "wata2022"
GITHUB_REPO = "chikugo-monitor"
GITHUB_WORKFLOW_ID = "update.yml"
GITHUB_REF = "master"

# Select an account-unique namespace ID before deployment.
# Approximate per-Cloudflare-location limit, not a worldwide hard quota.
[[ratelimits]]
name = "UPDATE_RATE_LIMITER"
namespace_id = "1001"
simple = { limit = 1, period = 60 }
